# Copy to .env to override defaults. No cloud API keys are needed.
OLLAMA_MODEL=llama3.2:1b
RATE_LIMIT_PER_MINUTE=120

# Optional: makes flags survive `docker compose down -v`.
# LAB_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Supabase (optional). Enables sign-up/sign-in, the admin console and cloud
# progress. Fill these in on Render (backend) after creating the Supabase
# project - see docs/Deployment_Guide.md for the exact steps.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role key from Supabase -> Settings -> API
# SUPABASE_JWT_SECRET=JWT Secret from Supabase -> Settings -> API
# CORS_ORIGINS=https://your-app.vercel.app
#
# The frontend needs its own variables (build time), set either in
# frontend/.env.local for local development or in Vercel -> Project
# Settings -> Environment Variables:
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=anon key from Supabase -> Settings -> API
# VITE_API_BASE=https://your-service.onrender.com/api
# VITE_GUIDE_BASE=https://github.com/your-user/your-repo/blob/main  (optional)
# ---------------------------------------------------------------------------
