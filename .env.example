# Copy to .env for local development. No cloud API keys are required: with no
# identity provider and no model key the labs run open and on the built-in
# deterministic simulator.
RATE_LIMIT_PER_MINUTE=120
# FLAG_RATE_LIMIT_PER_MINUTE=20
# FIXIT_TIMEOUT_SECONDS=8
# LOGIN_RATE_LIMIT_PER_MINUTE=10

# Optional: makes HMAC flags survive `docker compose down -v` / database resets.
# LAB_SECRET=change-me-to-a-long-random-string

# Optional: local data directory for SQLite (platform.db) and embedded Chroma.
# Docker sets this to /data automatically.
# LAB_DATA_DIR=/tmp/llm-lab-data

# ---------------------------------------------------------------------------
# Backend-owned accounts (local SQLite mode)
#
# Set JWT_SECRET to turn on sign-in and server-side progress. Generate a value:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# ADMIN_EMAIL / ADMIN_PASSWORD bootstrap one local administrator the first time
# the backend starts. They are ignored once the account exists, and they never
# overwrite a password. With Supabase configured, ADMIN_PASSWORD is not used;
# ADMIN_EMAIL only helps mirror the matching Supabase account's admin role.
#
# COOKIE_SECURE=0 is for http://localhost only. Set it to 1 on every HTTPS
# deployment, otherwise browsers will refuse to send the Secure cookies.
# ---------------------------------------------------------------------------
# JWT_SECRET=
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=
# AUTH_REQUIRED=1
# ACCESS_TOKEN_MINUTES=15
# REFRESH_TOKEN_DAYS=30
# JWT_ISSUER=owasp-llm-lab
# JWT_AUDIENCE=llm-lab-web
# COOKIE_SECURE=0

# ---------------------------------------------------------------------------
# Optional real LLMs (Groq and/or Gemini) - the only engines in the product.
# With no key the labs run on the deterministic simulator. With a key the real
# model serves LLM01/LLM02 and the independent LLM judge grades exploit output
# and reviews failing Fix-It code. The server picks Gemini first when both keys
# are present; there is no engine picker in the UI.
# Get a key: console.groq.com/keys  or  aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.5-flash
# LAB_PROVIDER=gemini       # gemini|groq; server-side only
# JUDGE_PROVIDER=auto       # auto = Groq if present, else Gemini; or groq|gemini
# JUDGE_MODEL=
# LLM_TIMEOUT_SECONDS=30
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (production / cloud mode)
#
# Supabase provides Postgres storage and, optionally, GoTrue password login.
# The backend still issues its own HttpOnly cookie session after GoTrue
# authenticates, so JWT_SECRET is required here too.
#
# Apply supabase/schema.sql and then
# supabase/migrations/20261111_platform_upgrade.sql before starting the backend.
# See docs/Deployment_Guide.md for the exact steps.
#
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_ANON_KEY=anon/publishable key from Supabase -> Settings -> API
# SUPABASE_SERVICE_ROLE_KEY=service_role key (server only - never ship to the browser)
# SUPABASE_JWT_SECRET=JWT secret, only for legacy bearer-token API clients
# CORS_ORIGINS=https://your-frontend.example.com
# MAX_COURSE_BYTES=524288
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Frontend (optional, build time). Create frontend/.env.local if you need to
# override the defaults. Do not put Supabase keys here: the browser never talks
# to Supabase directly.
#
# VITE_API_BASE=/api                          # keep same-origin in production
# VITE_PROXY_TARGET=http://127.0.0.1:8000     # Vite dev proxy only
# ---------------------------------------------------------------------------
