# Copy to .env to override defaults. No cloud API keys are needed.
RATE_LIMIT_PER_MINUTE=120

# Optional: makes flags survive `docker compose down -v`.
# LAB_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Optional real LLMs (Groq and/or Gemini) - the only engines in the product.
# With no key the labs run on the deterministic simulator. With a key the real
# model serves every run and the independent LLM judge grades exploit output
# and Fix-It code. The server picks Groq first, then Gemini; there is no
# engine picker in the UI.
# Get a key: console.groq.com/keys  or  aistudio.google.com/apikey
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash
# JUDGE_PROVIDER=auto        # auto = Groq if present, else Gemini; or groq|gemini
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase (optional). Enables sign-up/sign-in, the admin console and cloud
# progress. Fill these in on Render (backend) after creating the Supabase
# project - see docs/Deployment_Guide.md for the exact steps.
# SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=service_role key from Supabase -> Settings -> API
# SUPABASE_JWT_SECRET=JWT Secret from Supabase -> Settings -> API (legacy projects only)
# CORS_ORIGINS=https://your-app.vercel.app
#
# The frontend needs its own variables (build time), set either in
# frontend/.env.local for local development or in Vercel -> Project
# Settings -> Environment Variables:
# VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# VITE_SUPABASE_ANON_KEY=anon key from Supabase -> Settings -> API
# VITE_API_BASE=https://your-service.onrender.com/api
# ---------------------------------------------------------------------------
